# Checkmarx One Multi-Tool — credentials for a SINGLE tenant.
#
# Easiest path: don't hand-edit this. Give Claude (or run) your API key and let
# the tool derive the rest from it — the key is a JWT refresh token whose issuer
# encodes the IAM host and tenant:
#     python multitool.py env derive --api-key <KEY>   # preview base URL + tenant
#     python multitool.py env init   --api-key <KEY>    # write .env
#
# One chat/project = one tenant. This file holds exactly one tenant's config;
# switching tenants requires `env init --force` (prefer a separate chat instead).
# Keep .env out of version control.

# Required (env init fills these in for you)
CXONE_BASE_URL=https://ast.checkmarx.net      # your region's AST host
CXONE_TENANT=your_tenant_name
CXONE_API_KEY=ey...                            # tenant ADMIN API key (IAM needs admin)

# Optional
CXONE_IAM_BASE_URL=                            # override if iam host != ast->iam swap
CXONE_GITHUB_TOKEN=                            # PAT for GitHub repo onboarding
CXONE_AZURE_TOKEN=                             # Azure DevOps (set via: env set-token ado <tok>)
CXONE_GITLAB_TOKEN=                            # GitLab
CXONE_BITBUCKET_TOKEN=                         # Bitbucket
CXONE_DEBUG=false
CXONE_DRY_RUN=false
CXONE_WORKERS=10

# Optional — multi-user attribution: register secondary users' API keys with
# `identities add/import`; they live in cxone-identities.yaml next to this file
# (override the location with CXONE_IDENTITIES_FILE).
# CXONE_IDENTITIES_FILE=/path/to/cxone-identities.yaml
