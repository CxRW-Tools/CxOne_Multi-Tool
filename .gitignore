# Packaged skill artifacts (build output, not source — see scripts/package_skill.py)
dist/
*.skill

# Credentials / local runtime state — never commit these regardless of which
# skill directory they show up under
**/.env
**/cxone.env
**/cxone-identities.yaml
**/.agent_state.json
**/.selfcheck_state.json
agent.log*

# Python
**/__pycache__/
**/.venv/
*.pyc

# OS cruft (Mac + Windows dev machines)
.DS_Store
Thumbs.db

# Ad-hoc / scratch output that should never live in the skill folder —
# triage-real review packets and decision files, one-off scratch scripts,
# and generic temp/output dumps. These belong in the user's working
# directory or an OS scratch dir, not this repo; ignored here as a backstop.
packet*.json
decisions*.json
scratch/
tmp/
*.tmp
*.bak
